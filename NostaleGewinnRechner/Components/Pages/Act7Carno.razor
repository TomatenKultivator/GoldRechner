@page "/act7"
@page "/act7/carno"
@inherits RechnerPage

<PageTitle>Act 7 · Carno – NosTale Gewinnrechner</PageTitle>

<div class="page-head">
    <h1>Act 7 <span class="accent">Carno</span></h1>
    <p class="sub">Raids mit Bargold und Kisten-Drops.</p>
</div>

<div class="input-row">
    <div class="stat primary">
        <span class="stat-label">Gewinn Carno</span>
        <span class="stat-value @(A7.CarnoGewinn < 0 ? "loss" : "profit")">@Fmt.Gold(A7.CarnoGewinn)</span>
    </div>
</div>

<section class="calc-card">
    <header class="card-head"><h2>Carno</h2></header>
    <div class="input-row inner">
        <label class="big-input"><span>Anzahl Raids</span><GoldInput @bind-Value="A7.CarnoRaids" /></label>
        <label class="big-input"><span>Siegelpreis</span><GoldInput @bind-Value="A7.CarnoSiegel" /></label>
        <div class="big-input"><span>Bargold-Quelle</span><GoldModusToggle @bind-Direkt="A7.CarnoGoldDirekt" /></div>
        <label class="big-input @(A7.CarnoGoldDirekt ? "inaktiv" : "")"><span>Gold-Drops pro Raid</span><GoldInput @bind-Value="A7.CarnoDropsProRaid" /></label>
        <div class="stat @(A7.CarnoGoldDirekt ? "inaktiv" : "")"><span class="stat-label">Gold pro Drop</span><span class="stat-value">@Fmt.Gold(A7.CarnoGoldProDrop)</span></div>
        <div class="stat @(A7.CarnoGoldDirekt ? "inaktiv" : "")"><span class="stat-label">Bargold pro Raid</span><span class="stat-value">@Fmt.Gold(A7.CarnoBargoldProRaid)</span></div>
        <label class="big-input @(A7.CarnoGoldDirekt ? "" : "inaktiv")"><span>Gold gesamt gehoben <OhneRateHinweis /></span><GoldInput @bind-Value="A7.CarnoGoldGehoben" /></label>
    </div>
    <div class="table-wrap">
        <table class="calc-table">
            <thead><tr><th>Drop</th><th class="r editable">Anzahl</th><th class="r editable">Preis</th><th class="r">Erlös</th></tr></thead>
            <tbody>
                @foreach (var row in A7.CarnoKisten)
                {
                    <tr>
                        <td>@row.Name</td>
                        <td class="r"><GoldInput @bind-Value="row.Anzahl" /></td>
                        <td class="r"><GoldInput @bind-Value="row.Preis" /></td>
                        <td class="r">@Fmt.Gold(row.Gesamt)</td>
                    </tr>
                }
            </tbody>
            <tfoot>
                <tr class="result"><td colspan="3">Gewinn (inkl. Bargold, abzgl. Siegel)</td><td class="r @(A7.CarnoGewinn < 0 ? "loss" : "profit")">@Fmt.Gold(A7.CarnoGewinn)</td></tr>
            </tfoot>
        </table>
    </div>
</section>

@code {
    private Act7Rechner A7 => State.Act7;
}
