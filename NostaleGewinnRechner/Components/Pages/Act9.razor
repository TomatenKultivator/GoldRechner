@page "/act9"
@inherits RechnerPage

<PageTitle>Act 9 · Pollu – NosTale Gewinnrechner</PageTitle>

<div class="page-head">
    <h1>Act 9 <span class="accent">Pollu</span></h1>
    <p class="sub">Raids mit Gold-Drops, Kisten und Vollmonden – High-Rare-Kisten im Erweitert-Bereich.</p>
</div>

<div class="input-row">
    <div class="stat primary">
        <span class="stat-label">Gewinn gesamt</span>
        <span class="stat-value @(A9.Gesamt < 0 ? "loss" : "profit")">@Fmt.Gold(A9.Gesamt)</span>
    </div>
</div>

<div class="single-col">
    <section class="calc-card">
        <header class="card-head"><h2>Pollu</h2></header>
        <div class="table-wrap">
            <table class="calc-table">
                <tbody>
                    <tr><td>Anzahl Raids</td><td class="r"><GoldInput @bind-Value="A9.Raids" /></td></tr>
                    <tr><td>Siegelpreis</td><td class="r"><GoldInput @bind-Value="A9.SiegelPreis" /></td></tr>
                    <tr><td>Bargold-Quelle</td><td class="r"><GoldModusToggle @bind-Direkt="A9.GoldDirekt" /></td></tr>
                    <tr class="@(A9.GoldDirekt ? "zeile-inaktiv" : "")"><td>Anzahl Gold-Drops</td><td class="r"><GoldInput @bind-Value="A9.DropsProRaid" /></td></tr>
                    <tr class="@(A9.GoldDirekt ? "zeile-inaktiv" : "")"><td>Gold pro Drop</td><td class="r muted">@Fmt.Gold(A9.GoldProDrop)</td></tr>
                    <tr class="@(A9.GoldDirekt ? "zeile-inaktiv" : "")"><td class="muted">Gold pro Raid</td><td class="r">@Fmt.Gold(A9.GoldProRaid)</td></tr>
                    <tr class="@(A9.GoldDirekt ? "" : "zeile-inaktiv")"><td>Gold gesamt gehoben <OhneRateHinweis /></td><td class="r"><GoldInput @bind-Value="A9.GoldGehoben" /></td></tr>
                    <tr><td>Kisten (gesamter Run)</td><td class="r"><GoldInput @bind-Value="A9.BoxenAnzahl" /></td></tr>
                    <tr><td>Wert pro Kiste</td><td class="r"><GoldInput @bind-Value="A9.Boxenwert" /></td></tr>
                    <tr><td>Vollmonde (gesamter Run)</td><td class="r"><GoldInput @bind-Value="A9.VollmondeAnzahl" /></td></tr>
                    <tr><td>Preis Vollmond</td><td class="r"><GoldInput @bind-Value="A9.VollmondPreis" /></td></tr>
                    <tr class="section"><td colspan="2">Erweitert</td></tr>
                    <tr><td>High-Rare-Kisten (gesamter Run)</td><td class="r"><GoldInput @bind-Value="A9.HighRareAnzahl" /></td></tr>
                    <tr><td>Preis High-Rare-Kiste</td><td class="r"><GoldInput @bind-Value="A9.HighRarePreis" /></td></tr>
                    @if (!A9.GoldDirekt)
                    {
                        <tr><td class="muted">Goldgewinn pro Raid</td><td class="r @(A9.GoldgewinnProRaid < 0 ? "loss" : "")">@Fmt.Gold(A9.GoldgewinnProRaid)</td></tr>
                    }
                    <tr><td class="muted">Gold gesamt</td><td class="r @(A9.GoldGesamt < 0 ? "loss" : "")">@Fmt.Gold(A9.GoldGesamt)</td></tr>
                    <tr><td class="muted">Kisten gesamt</td><td class="r">@Fmt.Gold(A9.BoxenGesamt)</td></tr>
                    <tr><td class="muted">Vollmonde gesamt</td><td class="r">@Fmt.Gold(A9.VollmondeGesamt)</td></tr>
                    <tr><td class="muted">High-Rare gesamt</td><td class="r">@Fmt.Gold(A9.HighRareGesamt)</td></tr>
                </tbody>
                <tfoot>
                    <tr class="result"><td>Gewinn</td><td class="r @(A9.Gesamt < 0 ? "loss" : "profit")">@Fmt.Gold(A9.Gesamt)</td></tr>
                </tfoot>
            </table>
        </div>
    </section>
</div>

@code {
    private Act9Rechner A9 => State.Act9;
}
