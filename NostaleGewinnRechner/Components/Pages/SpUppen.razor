@page "/sp-uppen"
@inherits RechnerPage

<PageTitle>SP uppen – NosTale Gewinnrechner</PageTitle>

<div class="page-head">
    <h1>SP uppen</h1>
    <p class="sub">Preise einmal eintragen – der Vergleich zwischen normaler und Premium-Rolle rechnet sich von selbst.</p>
</div>

<div class="input-row">
    <label class="big-input">
        <span>Anzahl Rollen</span>
        <GoldInput @bind-Value="Sp.Anzahl" />
    </label>
    <div class="stat">
        <span class="stat-label">Normal gesamt</span>
        <span class="stat-value">@Fmt.Gold(Sp.NormalGesamt)</span>
    </div>
    <div class="stat">
        <span class="stat-label">Premium gesamt</span>
        <span class="stat-value">@Fmt.Gold(Sp.PremiumGesamt)</span>
    </div>
    <div class="stat primary">
        <span class="stat-label">@(Sp.PremiumAufpreis >= 0 ? "Premium-Aufpreis" : "Premium-Ersparnis")</span>
        <span class="stat-value @(Sp.PremiumAufpreis >= 0 ? "loss" : "profit")">@Fmt.Gold(Math.Abs(Sp.PremiumAufpreis))</span>
    </div>
</div>

<section class="calc-card">
    <header class="card-head"><h2>Preise</h2><span class="card-note">Gelten für beide Varianten</span></header>
    <div class="input-row inner">
        <label class="big-input"><span>Rolle Normal</span><GoldInput @bind-Value="Sp.PreisRolleNormal" /></label>
        <label class="big-input"><span>Rolle Premium</span><GoldInput @bind-Value="Sp.PreisRollePremium" /></label>
        <label class="big-input"><span>Vollmond</span><GoldInput @bind-Value="Sp.PreisVollmond" /></label>
        <label class="big-input"><span>Feder</span><GoldInput @bind-Value="Sp.PreisFeder" /></label>
        <label class="big-input"><span>Drachenedelstein</span><GoldInput @bind-Value="Sp.PreisEdelstein" /></label>
    </div>
</section>

<section class="calc-card">
    <header class="card-head">
        <h2>Vergleich pro Rolle</h2>
        <span class="badge">@(Sp.NormalProRolle <= Sp.PremiumProRolle ? "Normal günstiger" : "Premium günstiger")</span>
    </header>
    <div class="table-wrap">
        <table class="calc-table">
            <thead>
                <tr><th>Posten</th><th class="r">Normal</th><th class="r">Premium</th></tr>
            </thead>
            <tbody>
                <tr>
                    <td>Rolle</td>
                    <td class="r">@Fmt.Gold(Sp.PreisRolleNormal)</td>
                    <td class="r">@Fmt.Gold(Sp.PreisRollePremium)</td>
                </tr>
                <tr>
                    <td>Gold</td>
                    <td class="r">@Fmt.Gold(SpUppenRechner.GoldNormal)</td>
                    <td class="r">@Fmt.Gold(SpUppenRechner.GoldPremium)</td>
                </tr>
                <tr>
                    <td>Vollmonde <span class="muted">(@Fmt.Gold(SpUppenRechner.VollmondeNormal) / @Fmt.Gold(SpUppenRechner.VollmondePremium) Stück)</span></td>
                    <td class="r">@Fmt.Gold(SpUppenRechner.VollmondeNormal * Sp.PreisVollmond)</td>
                    <td class="r">@Fmt.Gold(SpUppenRechner.VollmondePremium * Sp.PreisVollmond)</td>
                </tr>
                <tr>
                    <td>Federn <span class="muted">(@Fmt.Gold(SpUppenRechner.FedernNormal) / @Fmt.Gold(SpUppenRechner.FedernPremium) Stück)</span></td>
                    <td class="r">@Fmt.Gold(SpUppenRechner.FedernNormal * Sp.PreisFeder)</td>
                    <td class="r">@Fmt.Gold(SpUppenRechner.FedernPremium * Sp.PreisFeder)</td>
                </tr>
                <tr>
                    <td>Drachenedelsteine <span class="muted">(@Fmt.Gold(SpUppenRechner.EdelsteineNormal) / @Fmt.Gold(SpUppenRechner.EdelsteinePremium) Stück)</span></td>
                    <td class="r">@Fmt.Gold(SpUppenRechner.EdelsteineNormal * Sp.PreisEdelstein)</td>
                    <td class="r">@Fmt.Gold(SpUppenRechner.EdelsteinePremium * Sp.PreisEdelstein)</td>
                </tr>
            </tbody>
            <tfoot>
                <tr class="result">
                    <td>Kosten pro Rolle</td>
                    <td class="r @(Sp.NormalProRolle <= Sp.PremiumProRolle ? "profit" : "")">@Fmt.Gold(Sp.NormalProRolle)</td>
                    <td class="r @(Sp.PremiumProRolle < Sp.NormalProRolle ? "profit" : "")">@Fmt.Gold(Sp.PremiumProRolle)</td>
                </tr>
            </tfoot>
        </table>
    </div>
</section>

@code {
    private SpUppenRechner Sp => State.SpUppen;
}
