@page "/act7/belial"
@inherits RechnerPage

<PageTitle>Act 7 · Belial – NosTale Gewinnrechner</PageTitle>

<div class="page-head">
    <h1>Act 7 <span class="accent">Belial</span></h1>
    <p class="sub">Raids mit Bargold – Boxen verkaufen oder öffnen.</p>
</div>

<div class="input-row">
    <div class="stat primary">
        <span class="stat-label">Gewinn Belial</span>
        <span class="stat-value @(A7.BelialGewinn < 0 ? "loss" : "profit")">@Fmt.Gold(A7.BelialGewinn)</span>
    </div>
</div>

<section class="calc-card">
    <header class="card-head">
        <h2>Belial</h2>
        <div class="seg">
            <button class="@(A7.BelialOeffnen ? "" : "on")" @onclick="() => A7.BelialOeffnen = false">Boxen verkaufen</button>
            <button class="@(A7.BelialOeffnen ? "on" : "")" @onclick="() => A7.BelialOeffnen = true">Boxen öffnen</button>
        </div>
    </header>
    <div class="input-row inner">
        <label class="big-input"><span>Anzahl Raids</span><GoldInput @bind-Value="A7.BelialRaids" /></label>
        <label class="big-input"><span>Siegelpreis</span><GoldInput @bind-Value="A7.BelialSiegel" /></label>
        <div class="big-input"><span>Bargold-Quelle</span><GoldModusToggle @bind-Direkt="A7.BelialGoldDirekt" /></div>
        <label class="big-input @(A7.BelialGoldDirekt ? "inaktiv" : "")"><span>Gold-Drops pro Raid</span><GoldInput @bind-Value="A7.BelialDropsProRaid" /></label>
        <div class="stat @(A7.BelialGoldDirekt ? "inaktiv" : "")"><span class="stat-label">Gold pro Drop</span><span class="stat-value">@Fmt.Gold(A7.BelialGoldProDrop)</span></div>
        <div class="stat @(A7.BelialGoldDirekt ? "inaktiv" : "")"><span class="stat-label">Bargold pro Raid</span><span class="stat-value">@Fmt.Gold(A7.BelialBargoldProRaid)</span></div>
        <label class="big-input @(A7.BelialGoldDirekt ? "" : "inaktiv")"><span>Gold gesamt gehoben</span><GoldInput @bind-Value="A7.BelialGoldGehoben" /></label>
        <div class="stat"><span class="stat-label">Goldgewinn</span><span class="stat-value @(A7.BelialGoldgewinn < 0 ? "loss" : "")">@Fmt.Gold(A7.BelialGoldgewinn)</span></div>
    </div>
    <div class="table-wrap">
        <table class="calc-table">
            <thead><tr><th>@(A7.BelialOeffnen ? "Inhalt" : "Boxen")</th><th class="r editable">Anzahl</th><th class="r editable">Preis</th><th class="r">Erlös</th></tr></thead>
            <tbody>
                @foreach (var row in A7.BelialOeffnen ? A7.BelialOeffnenItems : A7.BelialVerkauf)
                {
                    <tr>
                        <td>@row.Name</td>
                        <td class="r"><GoldInput @bind-Value="row.Anzahl" /></td>
                        <td class="r"><GoldInput @bind-Value="row.Preis" /></td>
                        <td class="r">@Fmt.Gold(row.Gesamt)</td>
                    </tr>
                }
            </tbody>
            <tfoot>
                <tr><td colspan="3">Erlös Boxen</td><td class="r">@Fmt.Gold(A7.BelialBoxenErloes)</td></tr>
                <tr class="result"><td colspan="3">Gewinn</td><td class="r @(A7.BelialGewinn < 0 ? "loss" : "profit")">@Fmt.Gold(A7.BelialGewinn)</td></tr>
            </tfoot>
        </table>
    </div>
</section>

@code {
    private Act7Rechner A7 => State.Act7;
}
