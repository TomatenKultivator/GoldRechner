@page "/act6/zenas"
@inherits RechnerPage

<PageTitle>Act 6 · Zenas – NosTale Gewinnrechner</PageTitle>

<div class="page-head">
    <h1>Act 6 <span class="accent">Zenas</span></h1>
    <p class="sub">Raid-Boss mit Siegelkosten, Goldgewinn und Boxenwert.</p>
</div>

<div class="input-row">
    <div class="stat primary">
        <span class="stat-label">Gewinn Zenas</span>
        <span class="stat-value @(State.Act6.Zenas.Gesamt < 0 ? "loss" : "profit")">@Fmt.Gold(State.Act6.Zenas.Gesamt)</span>
    </div>
</div>

<div class="single-col">
    <Act6BossKarte Boss="State.Act6.Zenas" />
</div>
