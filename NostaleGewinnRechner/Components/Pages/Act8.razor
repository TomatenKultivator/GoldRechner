@page "/act8"
@inherits RechnerPage

<PageTitle>Act 8 · Alzanor – NosTale Gewinnrechner</PageTitle>

<div class="page-head">
    <h1>Act 8 <span class="accent">Alzanor</span></h1>
    <p class="sub">Raids mit Gold-Drops und Kisten – High-Rare-Kisten im Erweitert-Bereich.</p>
</div>

<div class="input-row">
    <div class="stat primary">
        <span class="stat-label">Gewinn gesamt</span>
        <span class="stat-value @(A8.Gesamt < 0 ? "loss" : "profit")">@Fmt.Gold(A8.Gesamt)</span>
    </div>
</div>

<div class="single-col">
    <section class="calc-card">
        <header class="card-head"><h2>Alzanor</h2></header>
        <div class="table-wrap">
            <table class="calc-table">
                <tbody>
                    <tr><td>Anzahl Raids</td><td class="r"><GoldInput @bind-Value="A8.Raids" /></td></tr>
                    <tr><td>Siegelpreis</td><td class="r"><GoldInput @bind-Value="A8.SiegelPreis" /></td></tr>
                    <tr><td>Bargold-Quelle</td><td class="r"><GoldModusToggle @bind-Direkt="A8.GoldDirekt" /></td></tr>
                    <tr class="@(A8.GoldDirekt ? "zeile-inaktiv" : "")"><td>Anzahl Gold-Drops</td><td class="r"><GoldInput @bind-Value="A8.DropsProRaid" /></td></tr>
                    <tr class="@(A8.GoldDirekt ? "zeile-inaktiv" : "")"><td>Gold pro Drop</td><td class="r muted">@Fmt.Gold(A8.GoldProDrop)</td></tr>
                    <tr class="@(A8.GoldDirekt ? "zeile-inaktiv" : "")"><td class="muted">Gold pro Raid</td><td class="r">@Fmt.Gold(A8.GoldProRaid)</td></tr>
                    <tr class="@(A8.GoldDirekt ? "" : "zeile-inaktiv")"><td>Gold gesamt gehoben</td><td class="r"><GoldInput @bind-Value="A8.GoldGehoben" /></td></tr>
                    <tr><td>Kisten (gesamter Run)</td><td class="r"><GoldInput @bind-Value="A8.BoxenAnzahl" /></td></tr>
                    <tr><td>Wert pro Kiste</td><td class="r"><GoldInput @bind-Value="A8.Boxenwert" /></td></tr>
                    <tr class="section"><td colspan="2">Erweitert</td></tr>
                    <tr><td>High-Rare-Kisten (gesamter Run)</td><td class="r"><GoldInput @bind-Value="A8.HighRareAnzahl" /></td></tr>
                    <tr><td>Preis High-Rare-Kiste</td><td class="r"><GoldInput @bind-Value="A8.HighRarePreis" /></td></tr>
                    @if (!A8.GoldDirekt)
                    {
                        <tr><td class="muted">Goldgewinn pro Raid</td><td class="r @(A8.GoldgewinnProRaid < 0 ? "loss" : "")">@Fmt.Gold(A8.GoldgewinnProRaid)</td></tr>
                    }
                    <tr><td class="muted">Gold gesamt</td><td class="r @(A8.GoldGesamt < 0 ? "loss" : "")">@Fmt.Gold(A8.GoldGesamt)</td></tr>
                    <tr><td class="muted">Kisten gesamt</td><td class="r">@Fmt.Gold(A8.BoxenGesamt)</td></tr>
                    <tr><td class="muted">High-Rare gesamt</td><td class="r">@Fmt.Gold(A8.HighRareGesamt)</td></tr>
                </tbody>
                <tfoot>
                    <tr class="result"><td>Gewinn</td><td class="r @(A8.Gesamt < 0 ? "loss" : "profit")">@Fmt.Gold(A8.Gesamt)</td></tr>
                </tfoot>
            </table>
        </div>
    </section>
</div>

@code {
    private Act8Rechner A8 => State.Act8;
}
